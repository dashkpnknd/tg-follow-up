# Never commit real credentials.
BOT_TOKEN=
API_ID=
API_HASH=
# Set ACCESS_MODE=public to grant panel access to every person who opens the bot.
# Otherwise use a numeric group ID whose administrators
# may manage the bot. Add the bot to that group as an administrator.
ACCESS_MODE=group_admins
ADMIN_CHAT_ID=
# Legacy fallback: comma-separated Telegram numeric IDs allowed to manage this bot.
ADMIN_IDS=

DATABASE_PATH=data/followup.sqlite3
# Existing DialogHub database and Pyrogram-compatible session directory.
DIALOGHUB_DB_PATH=/opt/dialoghub/data/dialoghub.sqlite3
ACCOUNT_SESSIONS_DIR=/root/FULL_CRM/accounts
# Restrict import to this owner label in DialogHub. Empty means all accounts.
ACCOUNT_TITLE_PREFIX=Даниил

# Conservative defaults. Delivery is disabled and globally paused on first launch.
# DialogHub excludes replied dialogs first; only this recent safety tail is read
# for silent dialogs. Full-history reads are intentionally avoided.
HISTORY_LIMIT=100
SCAN_HISTORY_PAUSE_SECONDS=10
WORK_START_HOUR=10
WORK_END_HOUR=20
TIMEZONE=Europe/Moscow
MIN_DELAY_SECONDS=600
MAX_DELAY_SECONDS=900
MAX_PER_ACCOUNT_PER_DAY=20
SCAN_INTERVAL_SECONDS=900

# Customer check-in, 14 days after a sale.  The Google Sheet is read-only:
# the bot remembers completed rows in its own SQLite database.
# Give the bot a CSV export link (for example a Google Sheets published CSV)
# or a local CSV path.  Do not set both.
CHECKIN_SHEET_CSV_URL=
CHECKIN_SHEET_CSV_PATH=
# Internal label for the sender connected privately through the control bot.
# It is not a Telegram username and does not require DialogHub.
CHECKIN_ACCOUNT_TITLE=Local Traffic
# Main sales sheet columns: B=ДАТА, D=Описание проекта,
# E=Сумма сделки.  The bot uses the deal sum, not the salesperson's earning.
CHECKIN_SHEET_DATE_COLUMN=B
CHECKIN_SHEET_AMOUNT_COLUMN=E
CHECKIN_SHEET_PROJECT_COLUMN=D
# If the CSV shows dates as "30 августа" without the year, leave 0: the bot
# treats later months than today as belonging to the prior calendar year.
# Set an explicit year only for an archived single-year export.
CHECKIN_SHEET_YEAR=0
# Only sales dated on or after this date participate. Set it once on launch;
# rows already present before that date are never messaged.
CHECKIN_START_DATE=
CHECKIN_DAYS_AFTER_SALE=14
# Process today and one missed calendar day; older history is not sent on the
# first start by accident.
CHECKIN_DUE_GRACE_DAYS=1
CHECKIN_SCAN_INTERVAL_SECONDS=3600

# Renewal follow-ups. The bot downloads an XLSX export, because CSV exports
# do not preserve the red/white row colours used as the trigger.
# Example source: https://docs.google.com/spreadsheets/d/<ID>/export?format=xlsx
RENEWAL_SHEET_XLSX_URL=
RENEWAL_ACCOUNT_TITLE=Local Traffic
RENEWAL_SCAN_INTERVAL_SECONDS=86400
