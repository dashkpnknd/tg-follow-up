# Never commit real credentials.
BOT_TOKEN=
API_ID=
API_HASH=
# Comma-separated Telegram numeric IDs allowed to manage this bot.
ADMIN_IDS=

DATABASE_PATH=data/followup.sqlite3
# Existing DialogHub database and Pyrogram-compatible session directory.
DIALOGHUB_DB_PATH=/root/github-sync/tg-dialog-hub/data/dialoghub.sqlite3
ACCOUNT_SESSIONS_DIR=/root/FULL_CRM/accounts

# Conservative defaults. Delivery is disabled and globally paused on first launch.
HISTORY_LIMIT=10000
WORK_START_HOUR=10
WORK_END_HOUR=20
TIMEZONE=Europe/Moscow
MIN_DELAY_SECONDS=120
MAX_PER_ACCOUNT_PER_DAY=20
